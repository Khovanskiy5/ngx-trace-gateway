{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Теги образов nginx / OpenResty / Angie / whoami в compose, .env.example, Makefile, CI и тестах",
      "managerFilePatterns": [
        "/^compose(\\.nonroot)?\\.yaml$/",
        "/^\\.env\\.example$/",
        "/^Makefile$/",
        "/^scripts/test\\.sh$/",
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "(?<depName>openresty/openresty):(?<currentValue>[0-9][0-9.]*-(?:bookworm|alpine))",
        "(?<depName>nginx):(?<currentValue>1\\.[0-9]+\\.[0-9]+(?:-otel)?)",
        "(?<depName>docker\\.angie\\.software/angie):(?<currentValue>[0-9][0-9.]*)",
        "(?<depName>traefik/whoami):(?<currentValue>v[0-9][0-9.]*)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
