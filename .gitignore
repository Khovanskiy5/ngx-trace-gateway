# ------------------------------
# Project: ngx-trace-gateway
# IDE/системные файлы, локальные настройки, секреты и runtime-файлы
# ------------------------------

# OS/filesystem
.DS_Store
Thumbs.db

# IDE & editors
.idea/
.vscode/
*.iml
*.code-workspace
*.swp
*.swo
*.swx
*~
*.tmp
*.bak
*.orig
*.rej

# Docker & environment (шаблон .env.example коммитится)
.env
.env.*
!.env.example
compose.override.yaml
compose.override.yml
docker-compose.override.yml
docker-compose.override.yaml

# Логи (включая ротированные). *.gz целиком не игнорируем: gzip_static
# использует заранее сжатые ассеты рядом с оригиналами.
*.log
*.log.*

# Runtime-состояние
rootfs/var/www/maintenance/on
rootfs/var/www/acme/.well-known/acme-challenge/*
!rootfs/var/www/acme/.well-known/acme-challenge/.gitkeep

# Сертификаты и ключи (секреты не коммитим; dev-сертификат — `make certs`)
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
*.der
*.csr
*.srl

# Build/output
dist/
build/
coverage/
