# Скопируйте в .env и поменяйте нужное: cp .env.example .env
# Все значения необязательны — по умолчанию используется OpenResty.
# Командная строка и переменные окружения имеют приоритет над .env
# (NGX_IMAGE=nginx:1.30.5 NGX_BIN=nginx make test).

# --- Дистрибутив (образ и имя бинарника — парой) -----------------------------
# OpenResty (по умолчанию). Учтите: релизы OpenResty выходят позже nginx и
# 1.31.1.1 основан на nginx 1.31.1 — без исправлений безопасности nginx
# 1.31.2–1.31.6. Если Lua не нужен, для продакшена надёжнее nginx stable.
NGX_IMAGE=openresty/openresty:1.31.1.1-bookworm
NGX_BIN=openresty

# nginx stable / mainline:
# NGX_IMAGE=nginx:1.30.5
# NGX_BIN=nginx
# NGX_IMAGE=nginx:1.31.6
# NGX_BIN=nginx

# Angie:
# NGX_IMAGE=docker.angie.software/angie:1.12.2
# NGX_BIN=angie

# nginx с модулем OpenTelemetry (см. modules-available/otel.conf):
# NGX_IMAGE=nginx:1.30.5-otel
# NGX_BIN=nginx

# После смены образа пересоздайте контейнеры: `make down && make up`.
# В продакшене закрепляйте дайджест: образ:тег@sha256:…

# --- Имя узла ------------------------------------------------------------------
# Попадает в X-HOP-Name и в цепочку X-Request-Chain. Формат: [A-Za-z0-9._-]{1,64}.
HOP_NAME=edge-gateway

# --- Порты -------------------------------------------------------------------------
# BIND_ADDR=127.0.0.1 — доступ только с этой машины; 0.0.0.0 — со всех интерфейсов.
BIND_ADDR=127.0.0.1
HTTP_PORT=80
# Редирект http → https ведёт на стандартный порт 443. Если HTTPS_PORT другой,
# открывайте https://localhost:$HTTPS_PORT/ напрямую.
HTTPS_PORT=443

# --- Процессы ------------------------------------------------------------------------
# auto считает CPU хоста, а не квоту контейнера: при лимите CPU укажите число.
NGX_WORKER_PROCESSES=auto
NGX_PID=/run/nginx.pid

# --- Демо-бэкенд ----------------------------------------------------------------------
BACKEND_IMAGE=traefik/whoami:v1.11.0
